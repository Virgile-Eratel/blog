---
import Section from './Section.astro';
import Card from './Card.astro';
import { MarkdownInstance } from 'astro';

interface Props {
  posts: MarkdownInstance<any>[];
}

const { posts } = Astro.props;
---

<Section>
  <div class="flex justify-between pb-4">
    <p class="text-xl font-bold">Derniers Posts</p>
    <a href="/posts" class="underline hover:text-purple-600">tous les posts →</a>
  </div>
  <div class="grid grid-cols-1 gap-4 pb-4 md:grid-cols-3">
    {
      posts.map((post: any) => (
        <div>
          <Card post={post} />
        </div>
      ))
    }
  </div>
</Section>